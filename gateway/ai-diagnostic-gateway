#!/usr/bin/python3 -I
"""Root-owned forced command: fixed argv, clean environment, bounded IO."""
import os
import re
import selectors
import shutil
import subprocess
import sys
import time

COMMANDS = {
    "cpu": ["uptime"],
    "memory": ["free", "-m"],
    "disk": ["df", "-hT"],
    "network": ["ip", "-s", "link"],
    "sockets": ["ss", "-s"],
    "processes": ["ps", "-eo", "pid,ppid,user,stat,pcpu,pmem,comm", "--sort=-pcpu"],
}
SAFE_PATH = "/usr/sbin:/usr/bin:/sbin:/bin"


def run(args):
    executable = shutil.which(args[0], path=SAFE_PATH)
    if not executable:
        print("Diagnostic utility unavailable: " + args[0], file=sys.stderr)
        return 127
    process = subprocess.Popen([executable] + args[1:], stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               env={"PATH": SAFE_PATH, "LC_ALL": "C", "SYSTEMD_PAGER": "cat"})
    out, err = bytearray(), bytearray()
    code = None
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ, (out, 32768))
            selector.register(process.stderr, selectors.EVENT_READ, (err, 1800))
            deadline = time.monotonic() + 10
            while selector.get_map():
                if time.monotonic() >= deadline:
                    code = 124
                    err.extend(b"\nDiagnostic utility timed out\n")
                    break
                for item, _ in selector.select(timeout=0.1):
                    buf, limit = item.data
                    chunk = os.read(item.fd, 4096)
                    if not chunk:
                        selector.unregister(item.fileobj)
                        continue
                    available = limit - len(buf)
                    buf.extend(chunk[:available])
                    if len(chunk) > available:
                        code = 125
                        err.extend(b"\nDIAG_OUTPUT_TRUNCATED\n")
                        break
                if code is not None:
                    break
            if code is None:
                try:
                    code = process.wait(timeout=max(0.01, deadline - time.monotonic()))
                except subprocess.TimeoutExpired:
                    code = 124
                    err.extend(b"\nDiagnostic utility timed out\n")
    finally:
        if process.poll() is None:
            process.kill()
        process.wait()
        process.stdout.close()
        process.stderr.close()
    sys.stdout.buffer.write(out)
    sys.stderr.buffer.write(err[:2048])
    return code


def main():
    raw = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    if len(raw) > 128:
        return 2
    parts = raw.split(" ")
    if len(parts) == 1 and parts[0] in COMMANDS:
        args = COMMANDS[parts[0]]
    elif (len(parts) == 2 and parts[0] == "service" and
          re.fullmatch(r"[A-Za-z0-9_.@-]{1,64}", parts[1]) and not parts[1].startswith("-")):
        args = ["systemctl", "--no-pager", "is-active", "--", parts[1]]
    else:
        print("Denied", file=sys.stderr)
        return 2
    try:
        return run(args)
    except OSError:
        print("Diagnostic utility could not start", file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
